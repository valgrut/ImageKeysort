test:
	# python3 -m unittest discover
	python3 -m unittest tests.shortcutManagerTest

qss:
    qtsass $(SCSS_STYLES) -o $(QSS_STYLES)

clean:
	rm -rf dist
	rm -rf build
	rm image-keysort.spec
	rm -rf venv
	find . -type d -name "__pycache__" -exec rm -r {} +
	find . -name "*.pyc" -delete

