* {
  color: black; }

QWidget {
  font-family: "Inter";
  background-color: palette(Window); }

GalleryManager {
  border: 1px solid palette(Link);
  border-radius: 10px;
  padding: 3px;
  background-color: palette(Background); }

QStatusBar {
  min-height: 26px;
  border: 1px solid palette(Link);
  border-radius: 5px;
  font-size: 15px; }

QLabel {
  min-height: 20px;
  border: 1px solid palette(Link);
  border-radius: 5px;
  background-color: palette(Background);
  font-weight: bold;
  font-size: 15px;
  font-family: "Inter"; }

QLabel#statusBarLabel {
  min-height: 26px; }

QLabel#keyLabel {
  font-size: 16px;
  border-radius: 10px;
  color: palette(Background); }

QProgressBar {
  max-width: 250px; }

QPushButton {
  height: 20px;
  border: 1px solid palette(Link);
  border-radius: 5px;
  padding: 3px;
  background-color: palette(Button);
  font-weight: bold;
  font-size: 15px; }

QPushButton:hover {
  background-color: palette(Highlight); }

QPushButton:checked {
  background-color: palette(Base); }

QPushButton#clearTreeButton:hover {
  background-color: red; }

/***** MediaContainerWidget *****/
MediaContainerWidget QPushButton {
  width: 150px; }

MediaContainerWidget QPushButton:hover {
  background-color: palette(Highlight); }

MediaContainerWidget QLabel {
  font-weight: normal;
  font-size: 20px; }

/*
QStackedWidget QWidget[copyMode="false"],
QStackedWidget QWidget[copyMode="0"],
QStackedWidget QWidget:not([copyMode]) {
  border: none;
}*/
/*
QStackedWidget QWidget[copyMode="true"],
QStackedWidget QWidget[copyMode="1"] {
  border: 4px solid orange;
}*/
/***** QTreeWidget - Shortcuts tree *****/
QTreeWidget {
  min-width: 250px;
  width: 200px;
  border: 1px solid palette(Link);
  border-radius: 10px;
  background-color: palette(Background);
  color: black; }

QTreeWidget::header {
  background-color: red;
  min-height: 30px; }

QHeaderView {
  background-color: palette(Background);
  color: black;
  border: 0px solid black;
  border-radius: 10px;
  margin-top: 8px;
  min-height: 30px; }

QHeaderView::section {
  font-weight: bold;
  background-color: palette(Background);
  padding: 3px; }

/***** Settings Dialog styles *****/
SettingsDialog {
  border: 0;
  background-color: palette(Background);
  font-weight: normal; }

SettingsDialog * {
  background-color: palette(Background); }

SettingsDialog QFormLayout {
  background-color: palette(Background);
  border: 0; }

SettingsDialog QGroupBox {
  font-weight: bold; }

SettingsDialog QLabel {
  border: 0;
  font-weight: normal;
  font-size: 12px; }

/***** About dialog *****/
SettingsDialog QPushButton {
  border: 1px solid black; }

/***** Ask save message *****/
QMessageBox QPushButton {
  border: 1px solid black; }

QMessageBox QPushButton:hover {
  background-color: palette(Highlight); }

/***** About message *****/
QMessageBox {
  background-color: palette(Background); }

QMessageBox * {
  background-color: palette(Background);
  border: 0;
  font-weight: normal; }

/***** MenuBar, menu items *****/
QMenuBar {
  background-color: palette(Background);
  min-height: 30px; }

QMenu {
  background: #969696;
  /* Or any color you prefer for hover */
  color: black;
  /* Hover text color */
  border: 1px solid transparent;
  border-radius: 4px; }

QMenu::item {
  background-color: green;
  padding: 2px 25px 2px 20px;
  border-radius: 4px;
  border: 1px solid transparent;
  /* reserve space for selection border */ }

QMenu::item:selected {
  border-color: darkblue;
  border-radius: 4px;
  background: rgba(100, 100, 100, 58%); }

/***** EmptyGalleryWidget *****/
EmptyGalleryWidget {
  width: 100px;
  border: 1px solid palette(Link);
  border-radius: 10px;
  padding: 3px;
  background-color: #64bdbd; }

/***** ImageWidget *****/
ImageWidget {
  width: 100px;
  border: 1px solid palette(Link);
  border-radius: 10px;
  padding: 3px;
  background-color: #6464bd; }

/***** VideoWidget *****/
QGraphicsView {
  border: 2px solid palette(Link); }
